# Generated by app/stockfish.gradle from the pinned Stockfish submodule at
# build time; not source, regenerated on every clean checkout, and far too
# large (hundreds of MB, NNUE nets included) to keep in git.
/app/src/main/jniLibs/

# Compiled Stockfish objects left in the submodule's own working tree by
# app/stockfish.gradle (the submodule itself stays pinned/untouched).
/app/src/main/cpp/stockfish/src/*.o
/app/src/main/cpp/stockfish/src/stockfish
/app/src/main/cpp/stockfish/src/nn-*.nnue
