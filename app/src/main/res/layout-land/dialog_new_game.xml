<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape variant of the New Game form: two columns instead of one.
     In landscape the dialog's height is what is short - on a 7" tablet
     (600dp tall) or any phone, the single-column form does not fit above
     the dialog buttons, and the ScrollView that keeps it reachable gives
     no visible cue that the colour choice and the strength slider are
     waiting below the fold. Side by side, the opponent list on the left
     and everything that depends on it on the right, the tallest state
     (opening trainer: colour, opening, hint) is no taller than the four
     opponent radios, and the whole form is on screen at once.

     Same view ids as layout/dialog_new_game.xml, so DialogNewGameBinding
     and MainActivity#updateDialogVisibility work unchanged. The ScrollView
     stays as a last resort for extreme cases (multi-window, huge fonts). -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Column split. The right column gets slightly more room because the
         strength slider and the opening spinner want width; the opponent
         radios on the left are short labels. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.46" />

    <!-- Left column: opponent. -->

    <TextView
        android:id="@+id/opponentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_opponent"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- RadioGroup must stay a RadioGroup (a LinearLayout subclass) for its
         built-in mutual-exclusivity behavior; only the outer form container
         here is ConstraintLayout. -->
    <RadioGroup
        android:id="@+id/opponentGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/opponentLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/columnGuideline">

        <RadioButton
            android:id="@+id/opponentHuman"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opponent_human" />

        <RadioButton
            android:id="@+id/opponentEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/opponent_engine" />

        <RadioButton
            android:id="@+id/opponentMaia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opponent_maia" />

        <RadioButton
            android:id="@+id/opponentTraining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opponent_training" />
    </RadioGroup>

    <!-- Right column: colour, then whatever the chosen opponent needs.
         Top-aligned with the opponent label, 16dp clear of the guideline. -->

    <TextView
        android:id="@+id/colorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/dialog_color_title"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/columnGuideline" />

    <!-- baselineAligned="false": see layout/dialog_new_game.xml - the radio
         drawable's size differs per checked state and would throw the two
         labels off level. -->
    <RadioGroup
        android:id="@+id/colorGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/colorLabel"
        app:layout_constraintStart_toEndOf="@id/columnGuideline"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/colorWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:checked="true"
            android:text="@string/color_white" />

        <RadioButton
            android:id="@+id/colorBlack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color_black" />
    </RadioGroup>

    <TextView
        android:id="@+id/strengthLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        tools:text="Elo: 1500"
        app:layout_constraintTop_toBottomOf="@id/colorGroup"
        app:layout_constraintStart_toEndOf="@id/columnGuideline" />

    <SeekBar
        android:id="@+id/strengthSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:max="1870"
        android:progress="180"
        app:layout_constraintTop_toBottomOf="@id/strengthLabel"
        app:layout_constraintStart_toEndOf="@id/columnGuideline"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/maiaRatingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:visibility="gone"
        tools:text="Maia rating: 1500"
        app:layout_constraintTop_toBottomOf="@id/colorGroup"
        app:layout_constraintStart_toEndOf="@id/columnGuideline" />

    <!-- 9 discrete steps, index into MaiaRatings.ALL - see the portrait
         layout's note. -->
    <SeekBar
        android:id="@+id/maiaRatingSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:max="8"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/maiaRatingLabel"
        app:layout_constraintStart_toEndOf="@id/columnGuideline"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/openingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_opening_title"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/colorGroup"
        app:layout_constraintStart_toEndOf="@id/columnGuideline" />

    <Spinner
        android:id="@+id/openingSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/openingLabel"
        app:layout_constraintStart_toEndOf="@id/columnGuideline"
        app:layout_constraintEnd_toEndOf="parent" />

    <CheckBox
        android:id="@+id/hintCheckBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="@string/dialog_training_hint_checkbox"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/openingSpinner"
        app:layout_constraintStart_toEndOf="@id/columnGuideline"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
