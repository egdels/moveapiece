<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <de.schliweb.moveapiece.vision.BoardOutlineView
        android:id="@+id/cameraOutline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/cameraControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/cameraHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:accessibilityLiveRegion="polite"
            android:background="#99000000"
            android:gravity="center"
            android:minHeight="64dp"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:text="@string/board_camera_searching"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@android:color/white" />

        <ImageButton
            android:id="@+id/cameraShutter"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/board_camera_shutter"
            android:src="@drawable/ic_shutter" />
    </FrameLayout>
</FrameLayout>
